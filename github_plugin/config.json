{
    "display_name": "Github",
    "description": "Github external plugin",
    "logo_file": "Github-Logo.png",
    "integration_type": "ALM",
    "is_webhook_at_project_level": true,
    "instance_properties": [
        {
            "title": "Name",
            "name": "name",
            "description": "Name of the instance",
            "type": "input"
        },
        {
            "title": "Username",
            "name": "Username",
            "description": "Username of the instance",
            "type": "input"
        },
        {
            "title": "API Token",
            "name": "token",
            "description": "Github user API Token",
            "type": "input",
            "format": "password",
            "required": true
        },
        {
            "title": "URL",
            "name": "url",
            "description": "URL, for example: https://github.com/company",
            "type": "input"
        },
        {
            "title": "Organization",
            "name": "organization",
            "description": "GitHub organization login, for example: octocat",
            "type": "input",
            "required": true
        },
        {
            "title": "Description",
            "name": "description",
            "type": "input"
        }
    ],
    "assets_properties": [

        {
            "type":"custom",
            "title":"GitHub Project",
            "name":"github_project",
            "description":"Select a GitHub Project (v2), or No Project for a repository-only mapping",
            "api":"fetch_github_projects"
        },

        {
            "type": "project",
            "title": "Repositories",
            "name": "projects",
            "description": "To get the repositories",
            "is_render_treeview": true,
            "max_projects": 10,
            "is_fields_at_project_level": true,
            "dependent_assets": ["github_project"]
        },

        {
            "type": "asset", 
            "name": "issuetype_name",
            "title": "Issue Types",
            "description": "To get the issue types",
            "dependent_assets": ["projects","github_project"]
        }
    ],
    "additional_mapping": {
        "attachment": {
            "enabled": true 
        },
        "comment": {
            "enabled": true
        },
        "relationship": {
            "enabled": true
        },
        "sync_reference": {
            "enabled": true
        },
        
        "missing_events": {
            "enabled": true
        },
        "data_migration": {
            "enabled": true
        },
        "conflict_resolution": {
            "enabled": true
        },
        "sync_selected_event_type": {
            "enabled": true
        },
        "search_before_create": {
            "enabled": true,
            "search_query": [
                {
                    "field_types": ["text"],
                    "conditions": {
                        "equal": "="
                    }
                }
            ],
            "and_operator": " ",
            "or_operator": " OR "
        }
    }
}